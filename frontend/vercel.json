{
  "routes": [
    { "handle": "filesystem" },
    {
      "src": "^/(embed|preview)/(.*)$",
      "dest": "/embed/index.html",
      "headers": {
        "X-Frame-Options": "ALLOWALL",
        "Content-Security-Policy": "frame-ancestors *"
      }
    },
    { "src": "^/(.*)$", "dest": "/index.html" }
  ]
}
