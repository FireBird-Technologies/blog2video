# App-only routes get the SPA shell. Every indexable page (blog, help, tools, marketing, templates) is prerendered
# to a real file by scripts/build-seo.ts, and files win over these rewrites. There is deliberately NO /* catch-all:
# with a root 404.html, Cloudflare Pages returns a real 404 for unknown URLs instead of a 200 soft-404.
/_capture                              /  200
/pdf2video                             /  200
/signin                                /  200
/signup                                /  200
/template-showcase                     /  200
/wordpress-connect                     /  200
/wordpress-plugin                      /  200
/extension-connect                     /  200
/dashboard                             /  200
/project/*                             /  200
/invite/*                              /  200
/subscription                          /  200
/survey                                /  200
/integrations                          /  200
/mcp-connector                         /  200
/template-studio-editing-feature       /  200
/tools/substack-directory              /  200
/tools/substack-directory/*            /  200
/account/*                            /  200

# Standalone video player (embed/index.html): no app shell. Keep above the SPA fallback.
# Target the pretty URL /embed/, not /embed/index.html: Pages 308s .html paths to
# their pretty form, which makes a rewrite to them fall through to the SPA below.
/embed/*    /embed/  200
/preview/*  /embed/  200
