{
  "id": "starlit",
  "name": "Starlit",
  "new_template": true,
  "description": "A pure-black cosmic canvas with drifting stars, glowing planets, and constellation lines. Its complete visual system is derived only from one shared accent, text, and background palette.",
  "genres": [
    "Education",
    "Technology",
    "Science",
    "Blog",
    "Explainer"
  ],
  "preview_colors": {
    "accent": "#217cff",
    "bg": "#000000",
    "text": "#ffffff"
  },
  "composition_id": "StarlitVideo",
  "hero_layout": "cosmic_hero",
  "fallback_layout": "text_narration",
  "valid_layouts": [
    "cosmic_hero",
    "text_narration",
    "split_image",
    "stat_callout",
    "ringed_planet",
    "rocket_launch",
    "quote_card",
    "galaxy_deep_dive",
    "data_visualisation",
    "ticker_table",
    "ending_socials"
  ],
