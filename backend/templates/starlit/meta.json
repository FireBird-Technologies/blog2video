        "descriptionFontSize": {
          "portrait": 67,
          "landscape": 56
        },
        "seed": 42
      },
      "fields": [
        {
          "key": "titleFontSize",
          "label": "Title Font Size",
          "type": "number",
          "responsive": true,
          "min": 18,
          "max": 220,
          "step": 1
        },
        {
          "key": "descriptionFontSize",
          "label": "Body Font Size",
          "type": "number",
          "responsive": true,
          "min": 10,
          "max": 140,
          "step": 1
        },
        {
          "key": "title",
          "label": "Title",
          "type": "string",
          "description": "Main headline displayed in Space Grotesk 700."
        },
        {
          "key": "subtitle",
          "label": "Subtitle",
          "type": "string",
          "description": "Supporting line below the title in Inter 400."
        },
        {
          "key": "seed",
          "label": "Seed",
          "type": "number",
          "description": "Integer seed for deterministic star/sparkle positions.",
          "min": 0,
          "max": 500,
          "step": 1
        }
      ],
      "sample_props": {
        "title": "Mapping the Hidden Architecture of the Cosmos",
        "subtitle": "Follow the light of distant stars, trace the forces shaping galaxies, and discover how every observation brings the vast structure of our universe into sharper focus."
      }
    },
