  "description": "Hand-pencilled notes on a sheet of crumpled cream paper that gently shifts in the light. Each scene leaves with its own tear, fold or crumple, and one handwritten font runs through every layout.",
  "genres": [
    "Education",
    "Personal",
    "Blog",
    "Creative",
    "Explainer"
  ],
  "preview_colors": {
    "accent": "#8b5a2b",
    "bg": "#f9f5ec",
    "text": "#000000"
  },
  "composition_id": "CrumpledVideo",
  "hero_layout": "paper_hero",
  "fallback_layout": "sketch_narration",
  "valid_layouts": [
    "paper_hero",
    "sketch_narration",
    "taped_image",
    "pencil_stat",
    "sticky_list",
    "torn_quote",
    "fold_comparison",
    "data_visualisation",
    "ending_socials"
