{
  "id": "christmas",
  "name": "Snowy Christmas",
  "new_template": true,
  "description": "A bright snowy winter day with falling snow, an animated Santa and his reindeer, a Christmas tree that decorates itself, gift boxes, snowy ribbon banners and rolling snowballs. Every scene ends in a gust of snow.",
  "genres": [
    "Holiday",
    "Seasonal",
    "Marketing",
    "Personal",
    "Blog"
  ],
  "preview_colors": {
    "accent": "#D62839",
    "bg": "#EAF4FB",
    "text": "#12324A"
  },
  "composition_id": "ChristmasVideo",
  "hero_layout": "santa_hero",
  "fallback_layout": "snowy_narration",
  "valid_layouts": [
    "santa_hero",
    "snowy_narration",
    "frosted_window",
    "gift_stat",
    "tree_list",
    "letter_quote",
    "snow_compare",
    "snowball_steps",
