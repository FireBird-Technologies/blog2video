  "layouts_without_image": [
    "santa_hero",
    "gift_stat",
    "tree_list",
    "letter_quote",
    "snow_compare",
    "snowball_steps",
    "data_visualisation",
    "ending_socials"
  ],
  "layout_policy": {
    "required": {
      "gift_stat": ["stats"],
      "tree_list": ["items"],
      "letter_quote": ["quote"],
      "snow_compare": ["leftLabel", "leftPoints", "rightLabel", "rightPoints"],
      "snowball_steps": ["steps"]
    },
    "item_required": {
      "gift_stat": { "stats": ["value"] },
      "snowball_steps": { "steps": ["text"] }
    },
    "paired_lists": {
      "snow_compare": ["leftPoints", "rightPoints"]
    },
    "repairable": ["gift_stat", "tree_list", "snow_compare", "snowball_steps"],
    "always_fill": ["snow_compare"],
    "auto_pick": ["tree_list", "frosted_window", "snowball_steps", "snowy_narration"],
    "text_layouts": ["snowy_narration", "frosted_window"],
    "needs": {
      "gift_stat": "numbers",
      "letter_quote": "quote",
      "data_visualisation": "table"
    },
    "limits": {
      "snowy_narration": { "share": 0.15, "min_gap": 3 }
    }
  }
}
