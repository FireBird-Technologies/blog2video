{
  "manifest_version": 3,
  "name": "Blog2Video",
  "description": "Turn the page you're reading into a video with Blog2Video.",
  "version": "0.1.0",
  "icons": {
    "128": "icons/icon128.png"
  },
  "action": {
    "default_popup": "popup.html",
    "default_icon": "icons/icon32.png"
  },
  "background": {
    "service_worker": "src/background.js",
    "type": "module"
  },
  "permissions": ["activeTab", "storage", "scripting", "alarms"],
  "host_permissions": [
    "https://api-staging.blog2video.app/*",
    "https://blog2video.app/*"
  ]
}
