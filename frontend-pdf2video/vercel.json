{
  "routes": [
    { "handle": "filesystem" },
    {
      "src": "^/llms/json/?$",
      "dest": "/api/llms?format=json"
    },
    {
      "src": "^/llms/?$",
      "dest": "/api/llms"
    },
    {
      "src": "^/preview/(.*)$",
      "dest": "/index.html",
      "headers": {
        "X-Frame-Options": "ALLOWALL",
        "Content-Security-Policy": "frame-ancestors *"
      }
    },
    { "src": "^/(.*)$", "dest": "/index.html" }
  ]
}
